APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Two presets are provided. Comment out the one you're not using.
#
# PRESET A — SQLite (local development):
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
#
# PRESET B — MS SQL Server (production / staging):
# DB_CONNECTION=sqlsrv
# DB_HOST=localhost
# DB_PORT=1433
# DB_DATABASE=UIC_HSMS
# DB_USERNAME=uic_hsms_admin
# DB_PASSWORD=change-me
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=true
#
# Note: if your SQL Server uses a named instance (e.g., SQLEXPRESS),
# set DB_HOST=localhost\SQLEXPRESS instead of DB_HOST=localhost + DB_PORT.

# ============================================================
# FRONTEND
# ============================================================
FRONTEND_URL=http://localhost:5173

# ============================================================
# JWT CONFIGURATION
# ============================================================
# If JWT_SECRET is empty, the app falls back to APP_KEY for signing.
# For production, set a dedicated JWT_SECRET (32+ chars recommended) so
# the signing key can be rotated independently of APP_KEY.
JWT_SECRET=
JWT_TTL_MINUTES=60

# ============================================================
# SEEDING SAFETY (P5-6)
# ============================================================
# Set to `true` ONLY on demo/staging servers where you WANT the
# test accounts (coordinator@uic.edu.ph / coord123, nurse@..., doctor@...)
# to be created by `php artisan db:seed`.
#
# On production, this MUST be empty (or `false`).
# The seeder is disabled by default on any non-local environment,
# and requires this flag to run outside of `local`, `testing`, or `dev`.
ALLOW_TEST_USERS=

# ============================================================
# AI SUMMARY (Optional — ReportController uses this)
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=20

# ============================================================
# SESSION
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================================
# OTHER
# ============================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"